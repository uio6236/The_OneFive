<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.theonefive.employee.model.mapper.EmployeeMapper">
 
    <resultMap id="employeeResultMap" type="com.theonefive.employee.model.dto.EmployeeDTO">
        <id     property="id"       column="ID" />
        <result property="code"     column="CODE" />
        <result property="name"     column="NAME" />
        <result property="password" column="PASSWORD" />
        <result property="position" column="POSITION" />
        <result property="phone"    column="PHONE" />
        <result property="email"    column="EMAIL" />
    </resultMap>
 
    <select id="selectEmployeeById" resultMap="employeeResultMap" parameterType="long">
        SELECT ID, CODE, NAME, PASSWORD, POSITION, PHONE, EMAIL
        FROM EMPLOYEE
        WHERE ID = #{id}
    </select>
 
    <update id="updateEmployeeInfo" parameterType="com.theonefive.employee.model.dto.EmployeeDTO">
        UPDATE EMPLOYEE
        SET
            NAME  = #{name},
            PHONE = #{phone},
            EMAIL = #{email}
        WHERE ID = #{id}
    </update>
 
    <!-- 입력한 비밀번호가 현재 저장된 비밀번호와 같으면 1, 다르면 0 -->
    <select id="countEmployeeWithPassword" resultType="int">
        SELECT COUNT(*)
        FROM EMPLOYEE
        WHERE ID = #{id}
          AND PASSWORD = #{password}
    </select>
 
    <update id="updatePassword">
        UPDATE EMPLOYEE
        SET PASSWORD = #{newPassword}
        WHERE ID = #{id}
    </update>
 
</mapper>