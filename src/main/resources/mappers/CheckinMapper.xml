<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.theonefive.checkin.model.mapper.CheckinMapper">
	<select id="selectTodayCheckinList" resultType="CheckinDTO">
		SELECT *
        FROM CHECKIN_STATUS
        WHERE 1 = 0
	</select>
	<select id="selectTodayCheckoutList" resultType="CheckinDTO">
		SELECT *
        FROM CHECKIN_STATUS
        WHERE 1 = 0
	</select>
	<select id="selectCheckinDetail" parameterType="int" resultType="CheckinDTO">
		SELECT *
        FROM CHECKIN_STATUS
        WHERE ID = #{reservationId}
	</select>
	<insert id="insertCheckin" parameterType="CheckinDTO">
		INSERT INTO CHECKIN_STATUS (ID)
        VALUES (#{id})
	</insert>
	<update id="updateCheckout" parameterType="CheckinDTO">
		UPDATE CHECKIN_STATUS
        SET MEMO = #{memo}
        WHERE ID = #{id}
	</update>
	<select id="selectCheckinById" parameterType="int" resultType="CheckinDTO">
		SELECT *
        FROM CHECKIN_STATUS
        WHERE ID = #{checkinId}
	</select>
</mapper>
