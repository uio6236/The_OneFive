<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.theonefive.housekeeping.model.mapper.RoomMapper">

    <!--
      하우스키핑 상태 전이 시 함께 호출되는 객실 상태 변경.

      [Room 연동 예정]
      지금은 STATUS 컬럼 하나만 갱신하지만, "객실 현황" 페이지가 실제로 만들어지면
      그 화면에서도 이 STATUS 값을 그대로 읽어서 보여줘야 화면끼리 상태가 어긋나지 않음.
      만약 객실 현황 쪽에서 ROOM 테이블에 컬럼을 추가하거나(예: 마지막 청소 담당자,
      최근 점검일 등) 별도로 상태를 바꾸는 기능이 생기면, 이 UPDATE문과 충돌하지 않는지
      확인 필요.
    -->
    <update id="updateRoomStatus">
        UPDATE ROOM SET STATUS = #{status} WHERE ID = #{roomId}
    </update>

    <!--
      [Room 연동 예시 - 아직 사용되지 않음]
      RoomMapper.java의 selectById / selectAll 예시 메소드에 대응하는 SQL 형태.
      실제 ROOM 테이블 컬럼 구성(예: TYPE_ID, FLOOR 등)에 맞춰 나중에 작성 필요.

      <select id="selectById" resultType="RoomDTO">
          SELECT ID, ROOM_NUM, FLOOR, TYPE_ID, STATUS
          FROM ROOM
          WHERE ID = #{roomId}
      </select>

      <select id="selectAll" resultType="RoomDTO" parameterType="RoomSearchConditionDTO">
          SELECT ID, ROOM_NUM, FLOOR, TYPE_ID, STATUS
          FROM ROOM
          <where>
              <if test="floor != null">AND FLOOR = #{floor}</if>
              <if test="status != null and status != ''">AND STATUS = #{status}</if>
          </where>
      -->

</mapper>